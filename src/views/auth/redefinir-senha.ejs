<%- include('../partials/header') %>

<main class="recovery-main">
    <div class="recovery-container">
        <div class="recovery-header">
            <div class="logo">
                <h1>Redefinir Senha</h1>
            </div>
            <h2></h2>
            <p>Crie uma nova senha para sua conta</p>
        </div>

        <% if (error) { %>
            <div class="alert alert-error">
                <span>❌</span>
                <%= error %>
            </div>
        <% } %>

        <% if (token) { %>
            <form class="recovery-form" method="POST" action="/redefinir-senha/<%= token %>">
                <div class="form-group">
                    <label for="password">Nova Senha</label>
                    <input 
                        type="password" 
                        id="password" 
                        name="password" 
                        required 
                        autocomplete="new-password"
                        placeholder="Digite sua nova senha"
                        minlength="8"
                    >
                    <small class="password-hint">Senha deve ter: 8+ caracteres, maiúscula, minúscula, número e caractere especial</small>
                </div>
                
                <div class="form-group">
                    <label for="confirmPassword">Confirmar Nova Senha</label>
                    <input 
                        type="password" 
                        id="confirmPassword" 
                        name="confirmPassword" 
                        required 
                        autocomplete="new-password"
                        placeholder="Confirme sua nova senha"
                        minlength="8"
                    >
                </div>

                <button type="submit" class="btn btn-primary btn-full">
                    Redefinir Senha
                </button>
            </form>
        <% } else { %>
            <div class="alert alert-error">
                <span>❌</span>
                Link de redefinição inválido ou expirado
            </div>
        <% } %>

        <div class="recovery-links">
            <a href="/auth/login"> Voltar para o Login</a>
            <a href="/auth/registro"> Criar nova conta</a>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>