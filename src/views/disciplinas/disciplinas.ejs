<%- include('../partials/header') %>

<main class="disciplinas-main">
    <div class="disciplinas-container">
        <!-- Header com breadcrumb -->
        <div class="disciplinas-header">
            <div class="breadcrumb">
                <a href="/home">🏠 Home</a> / 
                <span>Disciplinas - <%= curso.nome %></span>
            </div>
            <h1>Disciplinas</h1>
            <p class="curso-info">Curso: <strong><%= curso.nome %></strong></p>
        </div>

        <!-- Mensagens de erro/sucesso -->
        <% if (error) { %>
            <div class="alert alert-error">
                <span>❌</span>
                <%= error %>
            </div>
        <% } %>

        <div class="disciplinas-content">
            <!-- Left Panel - Formulário -->
            <div class="left-panel">
                <section class="form-section">
                    <h2>📚 Adicionar Disciplina</h2>
                    <form class="disciplina-form" action="/curso/<%= curso.id %>/disciplinas" method="POST">
                        <div class="form-group">
                            <label for="nome">Nome da Disciplina *</label>
                            <input 
                                type="text" 
                                id="nome" 
                                name="nome" 
                                required 
                                autocomplete="off"
                                placeholder="Ex: Cálculo I"
                                value="<%= formData && formData.nome || '' %>"
                            >
                        </div>

                        <div class="form-group">
                            <label for="sigla">Sigla</label>
                            <input 
                                type="text" 
                                id="sigla" 
                                name="sigla" 
                                autocomplete="off"
                                placeholder="Ex: CAL1"
                                value="<%= formData && formData.sigla || '' %>"
                            >
                        </div>

                        <div class="form-group">
                            <label for="codigo">Código</label>
                            <input 
                                type="text" 
                                id="codigo" 
                                name="codigo" 
                                autocomplete="off"
                                placeholder="Ex: ES001"
                                value="<%= formData && formData.codigo || '' %>"
                            >
                        </div>

                        <div class="form-group">
                            <label for="periodo">Período *</label>
                            <input 
                                type="number" 
                                id="periodo" 
                                name="periodo" 
                                min="1" 
                                max="20"
                                value="<%= formData && formData.periodo || '1' %>"
                                required
                            >
                        </div>

                        <button type="submit" class="btn btn-primary btn-full">
                            💾 Salvar Disciplina
                        </button>
                    </form>
                </section>
            </div>

            <!-- Right Panel - Lista de Disciplinas -->
            <div class="right-panel">
                <section class="disciplinas-list">
                    <h2>📖 Disciplinas Cadastradas</h2>
                    
                    <% if (disciplinas && disciplinas.length > 0) { %>
                        <div class="disciplinas-grid">
                            <% disciplinas.forEach(disciplina => { %>
                                <div class="disciplina-card">
                                    <div class="card-header">
                                        <h3><%= disciplina.nome %></h3>
                                        <button class="btn-add-turma" 
                                                data-disciplina-id="<%= disciplina.id %>"
                                                data-disciplina-nome="<%= disciplina.nome %>">
                                            ➕
                                        </button>
                                    </div>
                                    
                                    <div class="card-details">
                                        <% if (disciplina.sigla) { %>
                                            <p><strong>Sigla:</strong> <%= disciplina.sigla %></p>
                                        <% } %>
                                        <% if (disciplina.codigo) { %>
                                            <p><strong>Código:</strong> <%= disciplina.codigo %></p>
                                        <% } %>
                                        <p><strong>Período:</strong> <%= disciplina.periodo %>º</p>
                                        <p><strong>Criada em:</strong> 
                                            <%= new Date(disciplina.created_at).toLocaleDateString('pt-BR') %>
                                        </p>
                                    </div>

                                    <div class="turmas-section">
                                        <h4>🏫 Turmas</h4>
                                        <ul class="turmas-list">
                                            <!-- Turmas serão carregadas via AJAX -->
                                            <li class="empty-message">Nenhuma turma cadastrada</li>
                                        </ul>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div class="empty-state">
                            <p>📭 Nenhuma disciplina cadastrada ainda.</p>
                            <p>Adicione sua primeira disciplina usando o formulário ao lado.</p>
                        </div>
                    <% } %>
                </section>
            </div>
        </div>
    </div>
</main>

<!-- Modal para adicionar turma -->
<div id="turmaModal" class="modal">
    <div class="modal-content">
        <span class="close-modal">&times;</span>
        <h3>Adicionar Turma</h3>
        <p id="modalDisciplinaNome"></p>
        <form id="turmaForm">
            <input type="hidden" id="modalDisciplinaId">
            <div class="form-group">
                <label for="turmaNome">Nome da Turma *</label>
                <input type="text" id="turmaNome" required autocomplete="off" placeholder="Ex: Turma A, Noturno">
            </div>
            <button type="submit" class="btn btn-primary">💾 Salvar Turma</button>
        </form>
    </div>
</div>

<script> src="/js/discplinas.js"</script>

<%- include('../partials/footer') %>