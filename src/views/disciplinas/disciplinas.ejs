<%- include('../partials/header') %>

<main class="disciplinas-main">
    <div class="disciplinas-container">
        <!-- Header -->
        <div class="disciplinas-header">
            <div class="breadcrumb">
                <a href="/home">Home</a> / 
                <span>Disciplinas</span>
            </div>
            <div class="header-actions">
                <h1>Disciplinas</h1>
                <% if (curso && curso.id) { %>
                    <a href="/curso/<%= curso.id %>/disciplinas/add" class="btn btn-primary">
                        Adicionar Disciplina
                    </a>
                <% } %>
            </div>
            <% if (curso && curso.nome) { %>
                <div class="curso-selecionado">
                    <p class="curso-info">Curso: <strong><%= curso.nome %></strong></p>
                    <% if (instituicao && instituicao.nome) { %>
                        <p class="instituicao-info">Instituição: <strong><%= instituicao.nome %></strong></p>
                    <% } %>
                </div>
            <% } %>
        </div>

        <!-- Mensagens -->
        <% if (error) { %>
            <div class="alert alert-error">
                <span class="alert-icon">!</span>
                <%= error %>
            </div>
        <% } %>
        
        <% if (success) { %>
            <div class="alert alert-success">
                <span class="alert-icon">✓</span>
                <%= success %>
            </div>
        <% } %>

        <div class="disciplinas-content">
            <% if (disciplinas && disciplinas.length > 0) { %>
                <div class="disciplinas-grid">
                    <% disciplinas.forEach(disciplina => { %>
                        <div class="disciplina-card" data-disciplina-id="<%= disciplina.id %>">
                            <div class="card-header">
                                <h3><%= disciplina.nome %></h3>
                                <div class="card-actions">
                                    <button class="btn-edit" title="Editar Disciplina">
                                        <span class="icon-edit">✏️</span>
                                    </button>
                                    <button class="btn-delete" title="Excluir Disciplina">
                                        <span class="icon-delete">🗑️</span>
                                    </button>
                                </div>
                            </div>
                            
                            <div class="card-details">
                                <% if (disciplina.sigla) { %>
                                    <p><strong>Sigla:</strong> <%= disciplina.sigla %></p>
                                <% } %>
                                <% if (disciplina.codigo) { %>
                                    <p><strong>Código:</strong> <%= disciplina.codigo %></p>
                                <% } %>
                                <p><strong>Período:</strong> <%= disciplina.periodo %></p>
                            </div>

                            <!-- Turmas -->
                            <div class="turmas-section">
                                <div class="turmas-header">
                                    <h4>Turmas</h4>
                                    <a href="/disciplina/<%= disciplina.id %>/turmas/add" class="btn-add-turma" title="Adicionar Turma">
                                        <span class="icon-add">➕<span>
                                    </a>
                                </div>
                                <% if (disciplina.turmas && disciplina.turmas.length > 0) { %>
                                    <ul class="turmas-list">
                                        <% disciplina.turmas.forEach(turma => { %>
                                            <li class="turma-item">
                                                <div class="turma-info">
                                                    <strong><%= turma.nome %></strong>
                                                    <% if (turma.dia_semana || turma.horario || turma.local) { %>
                                                        <div class="turma-details">
                                                            <% if (turma.dia_semana) { %>
                                                                <span><%= turma.dia_semana %></span>
                                                            <% } %>
                                                            <% if (turma.horario) { %>
                                                                <span><%= turma.horario %></span>
                                                            <% } %>
                                                            <% if (turma.local) { %>
                                                                <span><%= turma.local %></span>
                                                            <% } %>
                                                        </div>
                                                    <% } %>
                                                </div>
                                                <div class="turma-actions">
                                                    <button class="btn-alunos" data-turma-id="<%= turma.id %>" title="Gerenciar Alunos">
                                                        <span class="icon-alunos">Alunos</span>
                                                    </button>
                                                    <button class="btn-edit-turma" data-turma-id="<%= turma.id %>" title="Editar Turma">
                                                        <span class="icon-edit">✏️</span>
                                                    </button>
                                                    <button class="btn-delete-turma" data-turma-id="<%= turma.id %>" title="Excluir Turma">
                                                        <span class="icon-delete">🗑️</span>
                                                    </button>
                                                </div>
                                            </li>
                                        <% }); %>
                                    </ul>
                                <% } else { %>
                                    <p class="empty-message">Nenhuma turma cadastrada</p>
                                <% } %>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <p>Nenhuma disciplina cadastrada ainda.</p>
                    <% if (curso && curso.id) { %>
                        <a href="/curso/<%= curso.id %>/disciplinas/add" class="btn btn-primary">
                            Adicionar Primeira Disciplina
                        </a>
                    <% } else { %>
                        <a href="/home" class="btn btn-secondary">
                            Voltar para Home
                        </a>
                    <% } %>
                </div>
            <% } %>
        </div>
    </div>
</main>

<!-- Modal de Edição de Turma -->
<div id="turmaModal" class="modal" style="display: none;">
    <div class="modal-content">
        <div class="modal-header">
            <h2 id="modalTurmaTitle">Editar Turma</h2>
            <span class="close-modal">&times;</span>
        </div>
        <form id="turmaForm">
            <input type="hidden" id="modalTurmaId">
            <input type="hidden" id="modalDisciplinaId">
            
            <div class="form-group">
                <label for="turmaNome">Nome da Turma *</label>
                <input type="text" id="turmaNome" name="nome" required placeholder="Ex: Turma A, Noturno, Matutino">
            </div>
            
            <div class="form-row">
                <div class="form-group">
                    <label for="turmaDiaSemana">Dia da Semana</label>
                    <select id="turmaDiaSemana" name="dia_semana">
                        <option value="">Selecione o dia</option>
                        <option value="Segunda">Segunda-feira</option>
                        <option value="Terça">Terça-feira</option>
                        <option value="Quarta">Quarta-feira</option>
                        <option value="Quinta">Quinta-feira</option>
                        <option value="Sexta">Sexta-feira</option>
                        <option value="Sábado">Sábado</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label for="turmaHorario">Horário</label>
                    <input type="time" id="turmaHorario" name="horario">
                </div>
            </div>
            
            <div class="form-group">
                <label for="turmaLocal">Local</label>
                <input type="text" id="turmaLocal" name="local" placeholder="Ex: Sala 101, Laboratório 2">
            </div>
            
            <div class="form-actions">
                <button type="button" class="btn btn-secondary" id="cancelEdit">Cancelar</button>
                <button type="submit" class="btn btn-primary">Salvar Alterações</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal de Edição de Disciplina -->
<div id="disciplinaModal" class="modal" style="display: none;">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Editar Disciplina</h2>
            <span class="close-modal">&times;</span>
        </div>
        <form id="disciplinaForm">
            <input type="hidden" id="modalDisciplinaEditId">
            
            <div class="form-group">
                <label for="disciplinaNome">Nome *</label>
                <input type="text" id="disciplinaNome" name="nome" required>
            </div>
            <div class="form-group">
                <label for="disciplinaSigla">Sigla</label>
                <input type="text" id="disciplinaSigla" name="sigla">
            </div>
            <div class="form-group">
                <label for="disciplinaCodigo">Código</label>
                <input type="text" id="disciplinaCodigo" name="codigo">
            </div>
            <div class="form-group">
                <label for="disciplinaPeriodo">Período</label>
                <input type="text" id="disciplinaPeriodo" name="periodo">
            </div>

            <div class="form-actions">
                <button type="button" class="btn btn-secondary" id="cancelDisciplinaEdit">Cancelar</button>
                <button type="submit" class="btn btn-primary">Salvar Alterações</button>
            </div>
        </form>
    </div>
</div>

<script src="/js/disciplinas.js"></script>

<%- include('../partials/footer') %>
